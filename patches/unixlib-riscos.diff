+  ssb.channels = 2;
+  ssb.format = AFMT_S16_LE;
+  ssb.rate = 44100;
+  ssb.frag_out = SSB_OUT_FRAG_DEFAULT;
+  ssb.cap_out = SSB_OUT_FRAG_DEFAULT * SSB_NFRAGS_DEFAULT;
+  ssb.carry_len = 0;
