       case CLOCK_MONOTONIC:
 	{
-	  /* UnixLib's clock function reads RISC OS's Monotonic Timer
-	     and has centisecond resolution.  */
-	  clock_t c = clock ();
-	  tp->tv_sec = c / 100;
-	  tp->tv_nsec = (c - tp->tv_sec * 100) * 10000000;
+	  uint64_t ns = __ul_monotonic_ns ();
+	  tp->tv_sec = (time_t) (ns / 1000000000u);
+	  tp->tv_nsec = (long) (ns % 1000000000u);
 	  break;
 	}
 
