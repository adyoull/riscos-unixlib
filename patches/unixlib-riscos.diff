+  if (ssb.handle)
+    return NULL;
+  /* R0 bit 1: R2 is the usual block size.  */
+  err = _swix (XSharedSoundBuffer_OpenStream, _INR(0,2) | _OUT(0), 2,
+	       (name && *name) ? name : "UnixLib", ssb.frag_out, &ssb.handle);
+  if (err)
