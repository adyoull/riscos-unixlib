+@ Call one of the copied routines with ip = the RMA block.
+	.global	__pthread_ticker_call
+	NAME	__pthread_ticker_call
+__pthread_ticker_call:
+	STMFD	sp!, {a1, lr}
+	MOV	ip, a1
+	MOV	lr, pc
+	MOV	pc, a2
+	LDMFD	sp!, {a1, pc}
