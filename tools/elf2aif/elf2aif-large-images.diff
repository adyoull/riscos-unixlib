+/* Encode an ARM B/BL instruction (opcode 0xEA000000 or 0xEB000000) at file
+   offset 'from' that branches to file offset 'to'.  A branch reaches
+   +/-32MB; returns false if the target is out of range.  */
+static bool
+e2a_branch (uint32_t opcode, uint32_t from, uint32_t to, uint32_t *instP)
+{
+  int64_t delta = (int64_t) to - ((int64_t) from + 8);
+
+  if ((delta & 3) != 0 || delta < -(1 << 25) || delta >= (1 << 25))
+    return false;
+  *instP = opcode | ((uint32_t) (delta >> 2) & 0x00FFFFFF);
+  return true;
+}
